{"nodes": [{"id": "backend_readme_backend_service", "label": "Express + TypeScript Backend", "file_type": "document", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node.js / Express 4 / TypeScript 5 / Supabase / Zod / Axios / JWT. Implements the product flow PREDICT to EXPLAIN to PRIORITIZE to ACT."}, {"id": "backend_readme_fail_fast_env_validation", "label": "Fail-Fast Environment Validation", "file_type": "rationale", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The server refuses to start if any required environment variable is missing or malformed; it prints the offending fields and exits with code 1, so misconfiguration surfaces at boot rather than as a runtime fault."}, {"id": "backend_readme_health_endpoint", "label": "GET /health", "file_type": "concept", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns 200 whenever the process is serving; database state is reported in services.database.status (ok, schema_missing, unreachable), not in the HTTP status. Implemented in src/services/health.service.ts."}, {"id": "backend_readme_liveness_independent_of_db", "label": "Liveness Independent Of Database Health", "file_type": "rationale", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restarting the API because Postgres blipped turns a database incident into an API outage, and a health endpoint that goes dark is useless when you most need it. The probe reads one column of one row from projects under a 2s timeout so the endpoint cannot hang."}, {"id": "backend_readme_env_credentials", "label": "Environment-Sourced Credentials", "file_type": "concept", "source_file": "backend/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY and JWT_SECRET are required; ML_SERVICE_URL and ALLOWED_ORIGINS optional. Nothing is hardcoded and .env is gitignored; the service-role key is server-side only."}], "edges": [{"source": "backend_readme_backend_service", "target": "backend_readme_health_endpoint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/README.md", "source_location": null, "weight": 1.0}, {"source": "backend_readme_liveness_independent_of_db", "target": "backend_readme_health_endpoint", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/README.md", "source_location": null, "weight": 1.0}, {"source": "backend_readme_backend_service", "target": "docs_database_database_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/README.md", "source_location": null, "weight": 1.0}, {"source": "backend_readme_backend_service", "target": "backend_readme_env_credentials", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/README.md", "source_location": null, "weight": 1.0}, {"source": "backend_readme_fail_fast_env_validation", "target": "backend_readme_env_credentials", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/README.md", "source_location": null, "weight": 1.0}, {"source": "backend_readme_env_credentials", "target": "docs_architecture_credential_boundaries", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "backend/README.md", "source_location": null, "weight": 1.0}, {"source": "backend_readme_health_endpoint", "target": "docs_architecture_health_observability", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "backend/README.md", "source_location": null, "weight": 1.0}, {"source": "backend_readme_backend_service", "target": "docs_architecture_express_backend", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "backend/README.md", "source_location": null, "weight": 1.0}], "hyperedges": []}