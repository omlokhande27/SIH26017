{"nodes": [{"id": "readme_landguard_ai", "label": "LandGuard AI", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decision-support system for Indian infrastructure projects: tracks land acquisition, compensation, legal disputes and operational risk, and turns that record into early warnings about projects likely to slip."}, {"id": "readme_build_phases", "label": "Build Phase Roadmap", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phases 1-5 done (backend foundation, database schema/RLS, business APIs, FastAPI ML service, prediction orchestration); Phase 6 (dashboard APIs, LLM summaries, deployment) not started."}, {"id": "readme_three_test_layers", "label": "Three Non-Conflated Test Layers", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mocked (380 backend) and PGlite (179 database) suites prove logic; only the live suites (61 Supabase E2E, 12 ML integration, 64 live DB checks) prove the real project works. The layers are deliberately never conflated because a green mocked suite proves nothing about the deployed system."}, {"id": "readme_database_enforces_invariants", "label": "The Database Enforces Its Own Invariants", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derived values are generated columns, vocabularies are CHECK constraints or lookup tables, cross-table relationships are composite FKs. A rule enforced only in the API holds for exactly one caller; a CHECK constraint holds for direct SQL, admin edits and every future service."}, {"id": "readme_server_side_authorization", "label": "Authorization Is Resolved Server-Side", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The JWT proves who the caller is; public.profiles decides what they may do. Role is never read from the token because Supabase user_metadata is user-writable, so a correctly-signed token can carry any role its holder chose."}, {"id": "readme_no_fabricated_values", "label": "Nothing Is Invented To Fill A Gap", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A failed prediction stores NULL not 0; a missing feature is null not a substitute; a snapshot is refused rather than assembled from guesses. A fabricated zero is indistinguishable from a real measurement and gets learned as fact."}, {"id": "readme_category_separation", "label": "Categories Are Never Mixed", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified project data, imputed values, demo data, rule-based warnings, ML estimates and actual outcomes are distinct things and are labelled as such."}, {"id": "readme_ml_claim_matches_evidence", "label": "The ML Claim Matches The Evidence", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No trained model beat a median baseline on 130 rows with 22 distinct feature vectors and every R-squared negative, so the rule engine is the primary signal and the delay figure ships labelled BASELINE_MEDIAN with confidence LOW."}], "edges": [{"source": "readme_landguard_ai", "target": "backend_readme_backend_service", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "so