# ===========================================================================
# LandGuard AI — backend environment
#
# PLACEHOLDERS ONLY. Copy to `.env` and fill in real values there.
# `.env` is gitignored; this file is committed. Never put a real key here.
# ===========================================================================

# --- Server ----------------------------------------------------------------
PORT=5000
# development | production | test
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# --- Supabase project ------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co

# ---------------------------------------------------------------------------
# API KEYS — TWO GENERATIONS ARE SUPPORTED
#
# Supabase is migrating from legacy JWT-format keys to a new opaque format.
# Set ONE key from each pair. The new-format variable wins when both are set,
# so a migration completes by adding the new variable and later removing the
# old one.
#
# The key FORMAT and the VARIABLE NAME are independent — a new-format
# `sb_publishable_…` key sitting in SUPABASE_ANON_KEY works fine. What never
# changes is the privilege boundary:
#
#   publishable / anon      -> Row Level Security APPLIES
#   secret / service_role   -> Row Level Security IS BYPASSED
# ---------------------------------------------------------------------------

# Pick one (new format preferred). Safe to expose to a browser.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# SUPABASE_ANON_KEY=your-legacy-anon-key-here

# Pick one (new format preferred).
# SERVER-SIDE ONLY — bypasses RLS entirely. Never ship to a frontend,
# never return from an API, never log.
SUPABASE_SECRET_KEY=sb_secret_your-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key-here

# ---------------------------------------------------------------------------
# JWT VERIFICATION
#
#   auto   (default) determine the scheme by probing the project's JWKS
#          endpoint. Fails closed if the endpoint cannot be reached — it will
#          NOT downgrade to HS256 on an inconclusive probe.
#   jwks   asymmetric signing (ES256/RS256) verified against the project JWKS.
#   hs256  legacy shared-secret signing; requires JWT_SECRET.
#
# Pinning this explicitly is recommended once you know which scheme your
# project uses: it removes a startup network dependency and closes off the
# other verification path entirely.
# ---------------------------------------------------------------------------
SUPABASE_JWT_MODE=auto

# Required ONLY when SUPABASE_JWT_MODE=hs256 (or when `auto` detects a legacy
# project). Asymmetric projects have no shared secret — leave this unset
# rather than filling it with a placeholder.
# JWT_SECRET=your-supabase-jwt-secret-here

# Defaults to <SUPABASE_URL>/auth/v1. Override only for a proxied deployment.
# Run `npm run audit:supabase` to print the issuer your project actually uses.
# SUPABASE_JWT_ISSUER=

# Supabase uses "authenticated" for a signed-in user.
SUPABASE_JWT_AUDIENCE=authenticated

# --- ML service (Phase 4) --------------------------------------------------
# REQUIRED in production — startup fails without it rather than defaulting to
# localhost. Optional in development, where it falls back to the value below.
ML_SERVICE_URL=http://localhost:8000

# Optional until the ML service enforces authentication.
ML_SERVICE_API_KEY=

# --- LLM explanation layer (optional) --------------------------------------
# Leave blank to run without it. The system is fully functional either way:
# the LLM only rephrases results that were already computed in code. It never
# produces predictions, risk levels or numbers.
OPENAI_API_KEY=

# --- CORS ------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
