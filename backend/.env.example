# ===========================================================================
# LandGuard AI — backend environment
#
# PLACEHOLDERS ONLY. Copy to `.env` and fill in real values there.
# `.env` is gitignored; this file is committed. Never put a real key here.
# ===========================================================================

# --- Server ----------------------------------------------------------------
PORT=5000
# development | production | test
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co

# Safe to expose to a browser: RLS applies to it.
SUPABASE_ANON_KEY=your-anon-key-here

# SERVER-SIDE ONLY. Bypasses Row Level Security completely.
# Never ship this to the frontend and never return it from an API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Auth ------------------------------------------------------------------
# Supabase project JWT secret, used to verify incoming tokens (HS256).
# If your project uses asymmetric signing keys (ES256/RS256 via JWKS),
# the verification path in auth.middleware.ts needs updating — see docs.
JWT_SECRET=your-supabase-jwt-secret-here

# --- ML service (Phase 4) --------------------------------------------------
# REQUIRED in production — startup fails without it rather than defaulting to
# localhost. Optional in development, where it falls back to the value below.
ML_SERVICE_URL=http://localhost:8000

# Optional until the ML service enforces authentication.
ML_SERVICE_API_KEY=

# --- LLM explanation layer (optional) --------------------------------------
# Leave blank to run without it. The system is fully functional either way:
# the LLM only rephrases results that were already computed in code. It never
# produces predictions, risk levels or numbers.
OPENAI_API_KEY=

# --- CORS ------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
